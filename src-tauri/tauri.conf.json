{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoffeeShop",
  "version": "2.0.0",
  "identifier": "com.nasraddinzade.coffeeshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoffeeShop POS",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Ramin Nasraddinzade",
    "category": "Business",
    "shortDescription": "Offline-first coffee shop POS",
    "longDescription": "Offline-first point of sale for coffee shops: orders, products, resources, finance and reports. All data stays on the local machine."
  }
}
